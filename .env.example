# ============================================================
#  City Grievance Services — Environment Configuration
# ============================================================
#
#  SETUP INSTRUCTIONS
#  ------------------
#  1. Copy this file and rename the copy to ".env"
#        cp .env.example .env          (Linux / macOS)
#        copy .env.example .env        (Windows CMD)
#
#  2. Fill in the values below with your actual credentials.
#
#  3. NEVER commit the ".env" file to version control.
#     It is already listed in .gitignore.
#
#  NOTE: For a standard local XAMPP installation the default
#        values shown here will work without any changes.
# ============================================================


# ------------------------------------------------------------
#  Database Configuration
# ------------------------------------------------------------

# Hostname or IP address of your MySQL/MariaDB server.
# Use "localhost" for XAMPP / local development.
DB_SERVER=localhost

# MySQL username.
# XAMPP default is "root". Use a dedicated user in production.
DB_USER=root

# MySQL password.
# XAMPP default is empty. Always set a strong password in production.
DB_PASS=

# Database name. Must match the database you created when importing cms.sql.
DB_NAME=cms
